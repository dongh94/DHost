{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DHost",
  "version": "0.1.0",
  "identifier": "io.github.dongh94.dhost",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DHost",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "여러 고객사 Linux 서버를 관리하는 SSH 클라이언트",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4Q0VCMDgwRTNGOTUzOTEKUldTUlUvbmpnTERPU01HSkVDM1FuUlVVRGc1VTA5REg4OUJxMlIxeU16T3EzendyT2lzYWdwY1UK",
      "endpoints": [
        "https://github.com/dongh94/DHost/releases/latest/download/latest.json"
      ]
    }
  }
}
